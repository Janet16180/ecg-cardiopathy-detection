# Reference values: export them in your shell, or copy to .env and use
# `uv run --env-file .env ...`. The Makefile does not automatically load .env.
# Never put credentials into Git.
# Make supplies this default to protect the legacy experiment environments.
UV_PROJECT_ENVIRONMENT=.venv-uv
# Set this only when the team has provisioned a tracking service.
# MLFLOW_TRACKING_URI=https://your-team-tracking-server
